# Copy to .env and replace every value. .env is git-ignored -- never commit it.

# InfluxDB (admin credentials are only used for first-time setup)
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me-long-random-password
INFLUX_TOKEN=change-me-random-admin-token
INFLUX_ORG=crop-org
INFLUX_BUCKET=crop_data
# Scoped tokens: python -m src.dashboard.influxdb_setup --create-tokens
INFLUX_WRITE_TOKEN=
INFLUX_READ_TOKEN=

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# MQTT (one service account shared by publisher and bridge)
MQTT_USERNAME=crop-service
MQTT_PASSWORD=change-me-mqtt-password

# API
MODEL_CHECKPOINT=models/checkpoints/lstm_best.pt
API_KEYS=change-me-api-key
# Only for local development: allow /predict without an API key.
API_ALLOW_UNAUTHENTICATED=false
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=
