      "description": "Age of the most recent reading from the selected stations",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-crop"
          },
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"spectral_readings\")\n  |> filter(fn: (r) => r._field == \"nir_842\")\n  |> filter(fn: (r) => r.station_id =~ /^${station:regex}$/ and r.source =~ /^${source:regex}$/)\n  |> group()\n  |> last()\n  |> map(fn: (r) => ({_value: float(v: int(v: now()) - int(v: r._time)) / 1000000000.0}))"
