      "targets": [
        {
          "query": "from(bucket: \"crop_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"spectral_readings\")\n  |> filter(fn: (r) => r[\"station_id\"] =~ /^${station:regex}$/)\n  |> filter(fn: (r) => r[\"_field\"] == \"red_edge_705\" or r[\"_field\"] == \"red_edge_740\" or r[\"_field\"] == \"red_edge_783\" or r[\"_field\"] == \"nir_842\" or r[\"_field\"] == \"swir_1610\" or r[\"_field\"] == \"swir_2190\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"bands\")",
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-crop"
          }
