    {
      "type": "timeseries",
      "title": "Band reflectance — $station",
      "description": "Reflectance of each band (0-1). One panel per selected station.",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-crop"
          },
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"spectral_readings\")\n  |> filter(fn: (r) => r._field == \"red_edge_705\" or r._field == \"red_edge_740\" or r._field == \"red_edge_783\" or r._field == \"nir_842\" or r._field == \"swir_1610\" or r._field == \"swir_2190\")\n  |> filter(fn: (r) => r.station_id =~ /^${station:regex}$/ and r.source =~ /^${source:regex}$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "axisSoftMin": 0,
            "axisSoftMax": 1,
            "barAlignment": 0
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ],
          "showLegend": true
